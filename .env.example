# Copy to .env.local.
#
# Optional production-style local run:
#   npm run build && ./deploy/start-live-lab.sh
# Required (fail-closed): LAB_BASIC_USER, LAB_BASIC_PASS.
# Required for Gemini routes: GEMINI_API_KEY, GEMINI_MODEL.
# Adversarial sidecar: EVAL_API_URL, EVAL_INTERNAL_TOKEN.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash"
LAB_BASIC_USER="replace-with-a-username"
LAB_BASIC_PASS="replace-with-a-long-random-password"
EVAL_API_URL="http://127.0.0.1:8001"
EVAL_INTERNAL_TOKEN="replace-with-a-long-random-token"
APP_URL="http://localhost:3000"
